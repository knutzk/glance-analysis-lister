{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-FileCopyrightText: 2024-2026 Knut Zoch; SPDX-License-Identifier: GPL-3.0-only",
  "title": "GLANCE curated registry",
  "description": "Current generated registry structure. Unknown additions are allowed; validation inserts no defaults. See docs/file-reference.md.",
  "type": "object",
  "allOf": [
    {
      "$ref": "#/$defs/currentNamespace"
    }
  ],
  "properties": {
    "schema": {
      "const": "glance-curated-registry"
    },
    "counts": {
      "type": "object",
      "properties": {
        "analyses": {
          "type": "integer",
          "minimum": 0
        },
        "papers": {
          "type": "integer",
          "minimum": 0
        },
        "confnotes": {
          "type": "integer",
          "minimum": 0
        },
        "pubnotes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "analyses",
        "papers",
        "confnotes",
        "pubnotes"
      ]
    },
    "fetched_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "grove_curation": {
      "$ref": "#/$defs/curation"
    },
    "analyses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/analysis"
      }
    },
    "papers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/paper"
      }
    },
    "confnotes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      }
    },
    "pubnotes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      }
    }
  },
  "required": [
    "schema",
    "counts",
    "analyses",
    "papers",
    "confnotes",
    "pubnotes"
  ],
  "$defs": {
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "milestoneDate": {
      "description": "A source calendar date or timestamp, null, or an empty source value. No timezone conversion or historical inference is applied.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "const": ""
        },
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ],
      "title": "ISO date or timestamp, null, or empty string"
    },
    "paperTimestamp": {
      "description": "A paper publication milestone, also accepting the API's timezone-free YYYY-MM-DDTHH:MM representation without conversion.",
      "anyOf": [
        {
          "$ref": "#/$defs/milestoneDate"
        },
        {
          "$comment": "JSON Schema date-time requires a timezone. This pattern validates Gregorian dates (including century leap-year rules) and hours/minutes without custom format checkers. Length excludes trailing newlines accepted by some regex end anchors.",
          "type": "string",
          "minLength": 16,
          "maxLength": 16,
          "pattern": "^(?!0000)(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      ],
      "title": "ISO date, timezone-bearing timestamp or local YYYY-MM-DDTHH:MM, null, or empty string"
    },
    "link": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/text"
        },
        "referenceCode": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "url": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "groups": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "leadingGroup": {
          "$ref": "#/$defs/text"
        },
        "leadingSubgroup": {
          "$ref": "#/$defs/text"
        },
        "otherGroups": {
          "$ref": "#/$defs/optionalNames"
        },
        "subgroups": {
          "$ref": "#/$defs/optionalNames"
        }
      }
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "grove_keywords": {
          "$ref": "#/$defs/optionalNames"
        },
        "grove_triggers": {
          "$ref": "#/$defs/optionalNames"
        },
        "grove_statisticalTools": {
          "$ref": "#/$defs/optionalNames"
        }
      }
    },
    "documentation": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "supportingInternalDocuments": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/url"
          }
        }
      }
    },
    "provenance": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/text"
        },
        "source": {
          "$ref": "#/$defs/text"
        },
        "source_url": {
          "$ref": "#/$defs/text"
        },
        "api_field": {
          "$ref": "#/$defs/text"
        },
        "cds_record": {
          "$ref": "#/$defs/text"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "availability_checked": {
          "type": "boolean"
        }
      }
    },
    "doi": {
      "type": "object",
      "properties": {
        "doi": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "$ref": "#/$defs/text"
        },
        "citation": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "collision": {
      "type": "object",
      "properties": {
        "year": {
          "$ref": "#/$defs/text"
        },
        "run": {
          "$ref": "#/$defs/text"
        },
        "type": {
          "$ref": "#/$defs/text"
        },
        "ecmValue": {
          "$ref": "#/$defs/text"
        },
        "ecmUnit": {
          "$ref": "#/$defs/text"
        },
        "luminosityValue": {
          "$ref": "#/$defs/text"
        },
        "luminosityUnit": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "common": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/text"
        },
        "shortTitle": {
          "$ref": "#/$defs/text"
        },
        "grove_analysisContacts": {
          "$ref": "#/$defs/names"
        },
        "grove_contactEditors": {
          "$ref": "#/$defs/names"
        },
        "grove_groups": {
          "$ref": "#/$defs/groups"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "documentation": {
          "$ref": "#/$defs/documentation"
        },
        "analysisTeam": false
      },
      "required": [
        "grove_analysisContacts",
        "grove_contactEditors"
      ]
    },
    "publication": {
      "type": "object",
      "properties": {
        "relatedAnalysis": {
          "$ref": "#/$defs/link"
        },
        "grove_publicationProvenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "analysisPhase": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/text"
        },
        "startDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "editorialBoardFormedDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "pgcOrSgcSignOffDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "grove_editorialBoard": {
          "$ref": "#/$defs/people"
        },
        "grove_editorialBoardChairs": {
          "$ref": "#/$defs/people"
        },
        "grove_eoiMeetingDates": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date"
          }
        },
        "grove_editorialBoardRequestMeetingDates": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date"
          }
        },
        "grove_preApprovalMeetingDates": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date"
          }
        },
        "grove_approvalMeetingDates": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "paperPhase1": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "grove_editorialBoard": {
          "$ref": "#/$defs/people"
        },
        "grove_editorialBoardChairs": {
          "$ref": "#/$defs/people"
        },
        "grove_editorialBoardExOfficio": {
          "$ref": "#/$defs/people"
        },
        "grove_readers": {
          "$ref": "#/$defs/people"
        },
        "grove_firstReaders": {
          "$ref": "#/$defs/people"
        },
        "grove_secondReaders": {
          "$ref": "#/$defs/people"
        },
        "grove_firstSignOffResponsible": {
          "$ref": "#/$defs/people"
        },
        "grove_secondSignOffResponsible": {
          "$ref": "#/$defs/people"
        },
        "startDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "editorialBoardFormedDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "pgcApprovalDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "editorialBoardDraftSignOffDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "languageEditorsSignOffDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "draftReleasedDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "presentationDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "atlasMeetingDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "pubcommSignOffDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "publicWebPageUrlForFiguresAndTables": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "paperPhase2": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "startDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "editorialBoardDraft2SignOffDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "draft2SentToCernDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "draft2CernSignOffDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "draft2ReleasedDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "editorialBoardRevisedSignOffDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "pubcommChairOrDeputySignOffDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "spokespersonDelegatedSignOffDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "spokespersonOrDeputySignOffDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "paperClosureDate": {
          "$ref": "#/$defs/milestoneDate"
        }
      }
    },
    "publicationPhase": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "startDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "arXivSubmissionDate": {
          "$ref": "#/$defs/paperTimestamp"
        },
        "firstRefereeReportDate": {
          "$ref": "#/$defs/paperTimestamp"
        },
        "journalAcceptanceDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "firstProofDate": {
          "$ref": "#/$defs/paperTimestamp"
        },
        "publishedOnlineDate": {
          "$ref": "#/$defs/paperTimestamp"
        },
        "finalSubmissionJournal": {
          "$ref": "#/$defs/text"
        },
        "arXivUrls": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/url"
          }
        },
        "grove_dois": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/doi"
          }
        },
        "finalTitleTex": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "noteMetadata": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "grove_keywords": {
          "$ref": "#/$defs/optionalNames"
        },
        "grove_triggers": {
          "$ref": "#/$defs/optionalNames"
        },
        "grove_statisticalTools": {
          "$ref": "#/$defs/optionalNames"
        },
        "mvaMlTools": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "$ref": "#/$defs/text"
                  }
                }
              }
            ]
          }
        },
        "collisions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/collision"
          }
        }
      }
    },
    "notePhase": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "grove_editorialBoard": {
          "$ref": "#/$defs/people"
        },
        "grove_editorialBoardChairs": {
          "$ref": "#/$defs/people"
        },
        "grove_editorialBoardExOfficio": {
          "$ref": "#/$defs/people"
        },
        "grove_readers": {
          "$ref": "#/$defs/people"
        },
        "grove_firstReaders": {
          "$ref": "#/$defs/people"
        },
        "grove_secondReaders": {
          "$ref": "#/$defs/people"
        },
        "grove_firstSignOffResponsible": {
          "$ref": "#/$defs/people"
        },
        "grove_secondSignOffResponsible": {
          "$ref": "#/$defs/people"
        },
        "releaseDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "pgcApprovalDate": {
          "$ref": "#/$defs/milestoneDate"
        },
        "draftCdsUrl": {
          "$ref": "#/$defs/text"
        },
        "publicWebPageUrlForFiguresAndTables": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "analysis": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "properties": {
            "referenceCode": {
              "$ref": "#/$defs/identifier"
            },
            "relatedPublications": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/link"
              }
            },
            "phase0": {
              "$ref": "#/$defs/analysisPhase"
            }
          },
          "required": [
            "referenceCode"
          ]
        }
      ]
    },
    "paper": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "$ref": "#/$defs/publication"
        },
        {
          "type": "object",
          "properties": {
            "referenceCode": {
              "$ref": "#/$defs/identifier"
            },
            "grove_figuresUrl": {
              "$ref": "#/$defs/text"
            },
            "phase1": {
              "$ref": "#/$defs/paperPhase1"
            },
            "phase2": {
              "$ref": "#/$defs/paperPhase2"
            },
            "publicationPhase": {
              "$ref": "#/$defs/publicationPhase"
            },
            "fullTitle": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "referenceCode"
          ]
        }
      ]
    },
    "note": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "$ref": "#/$defs/publication"
        },
        {
          "type": "object",
          "properties": {
            "temporaryReferenceCode": {
              "$ref": "#/$defs/identifier"
            },
            "finalReferenceCode": {
              "$ref": "#/$defs/text"
            },
            "grove_finalReferenceCode": {
              "$ref": "#/$defs/text"
            },
            "supersededBy": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/link"
              }
            },
            "metadata": {
              "$ref": "#/$defs/noteMetadata"
            },
            "phase1": {
              "$ref": "#/$defs/notePhase"
            }
          },
          "required": [
            "temporaryReferenceCode"
          ]
        }
      ]
    },
    "store": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "curation": {
      "type": "object",
      "properties": {
        "built_at": {
          "type": "string",
          "format": "date-time"
        },
        "contacts_as_of": {
          "type": "string",
          "format": "date"
        },
        "api_schema": {
          "type": "string"
        },
        "doi_statistics": {
          "type": "object",
          "properties": {
            "papers_with_dois": {
              "type": "integer",
              "minimum": 0
            },
            "resolved": {
              "type": "integer",
              "minimum": 0
            },
            "unresolved": {
              "type": "integer",
              "minimum": 0
            },
            "malformed_links": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "public_identifier_statistics": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "citation_store": {
          "$ref": "#/$defs/store"
        },
        "pubnote_identifier_store": {
          "$ref": "#/$defs/store"
        }
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "client": {
          "type": "string"
        },
        "client_version": {
          "type": "string"
        },
        "selection": {
          "type": "string"
        },
        "representation": {
          "type": "string"
        },
        "base_url": {
          "type": "string"
        },
        "page_size": {
          "type": "integer",
          "minimum": 1
        },
        "sort_fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "sort_descending": {
          "type": "boolean"
        }
      }
    },
    "optionalNames": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "people": {
      "anyOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/names"
        }
      ]
    },
    "currentNamespace": {
      "description": "Reject retired gal_ field names, including mixed namespaces; rebuild from saved API input.",
      "if": {
        "type": "object"
      },
      "then": {
        "propertyNames": {
          "not": {
            "pattern": "^gal_"
          }
        },
        "additionalProperties": {
          "$ref": "#/$defs/currentNamespace"
        }
      },
      "else": {
        "if": {
          "type": "array"
        },
        "then": {
          "items": {
            "$ref": "#/$defs/currentNamespace"
          }
        }
      }
    }
  }
}
